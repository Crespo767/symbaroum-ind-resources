<form class="{{cssClass}}" autocomplete="off">
    <div class="player party">
        <div class="sheet-header foreground border">
            <div class="avatar" style="position:relative">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" data-tooltip="{{actor.name}}" />
                {{#ifgt system.nbrOfFailedDeathRoll 0}}
                <div data-tooltip="{{localize "TOOLTIP.DEATH_SKULLS"}}" style="position: absolute; top: 70%;left: 15px;">{{#times system.nbrOfFailedDeathRoll}}<i class="fas fa-skull" style="margin: 5px; color:rgb(255, 255, 255); vertical-align: bottom; -webkit-text-stroke-width: 1px; -webkit-text-stroke-color: rgb(0, 0, 0);"></i>{{/times}}</div>
                {{/ifgt}}
            </div>
            <div class="wrapper-column">
                <div class="wrapper-row">
                    <div class="name">
                        <label for="{{id}}-name">{{localize "BIO.NAME"}}</label>
                        <input id="{{id}}-name" name="name" type="text" value="{{actor.name}}" />
                    </div>
                    {{#ifNotLimited actor}}
                        <div class="experience">
                            <label for="data.experience.total">{{localize "EXPERIENCE"}}</label>
                            <input id="data.experience.total" name="system.experience.total" data-tooltip="{{localize "TOOLTIP.EXPERIENCE_TOTAL"}}" type="number" value="{{system.experience.total}}" data-dtype="Number" />
                            <input name="system.experience.artifactrr" data-tooltip="{{localize "TOOLTIP.EXPERIENCE_ARTIFACTRR"}}" type="number" value="{{system.experience.artifactrr}}" data-dtype="Number" />
                            <input name="system.experience.spent" data-tooltip="{{localize "TOOLTIP.EXPERIENCE_SPENT"}}" type="number" value="{{system.experience.spent}}" data-dtype="Number" disabled />
                            <input name="system.experience.available" data-tooltip="{{localize "TOOLTIP.EXPERIENCE_AVAILABLE"}}" type="number" value="{{system.experience.available}}" data-dtype="Number" disabled />
                        </div>
                    {{/ifNotLimited}}
                </div>
            </div>
        </div>

        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="characters">{{localize "TENEBRE.Party.TabCharacters"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="characters">
                <div class="party-members-list" style="display: flex; flex-direction: column; gap: 8px; margin: 5px;">
                    {{#each members}}
                    <div class="party-member-row" data-actor-id="{{id}}" style="display: flex; flex-direction: row; align-items: stretch; gap: 6px; width: 100%;">
                        <div class="member-portrait foreground border" data-action="open-member-sheet" data-actor-id="{{id}}" data-tooltip="{{name}}" style="flex: 0 0 90px; height: 80px; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; padding: 2px;">
                            <img src="{{img}}" alt="{{name}}" style="width: 100%; height: 100%; object-fit: cover; border: 0 none; display: block;" />
                        </div>
                        <div class="member-info foreground border" style="flex: 1; min-height: 80px; display: flex; align-items: center; justify-content: space-between; padding: 10px 14px;">
                            <div class="member-details" data-action="open-member-sheet" data-actor-id="{{id}}" style="cursor: pointer; display: flex; flex-direction: column; gap: 4px;">
                                <span class="member-name" style="font-family: var(--font-title); font-size: 1.15em; font-weight: bold; color: var(--color-title);">{{name}}</span>
                                {{#if system.bio.race}}
                                <span class="member-sub" style="font-size: 0.85em; opacity: 0.85;">{{system.bio.race}}{{#if system.bio.occupation}} · {{system.bio.occupation}}{{/if}}</span>
                                {{/if}}
                            </div>
                            {{#if ../editable}}
                            <div class="member-actions" style="display: flex; align-items: center;">
                                <a class="item-control member-delete" data-action="remove-member" data-actor-id="{{id}}" data-tooltip="{{localize "TENEBRE.Party.RemoveMember"}}" style="color: #8b0000; cursor: pointer; padding: 6px 8px; font-size: 1.1em;">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}

                    {{#unless members.length}}
                    <div class="party-empty-dropzone" style="text-align: center; color: var(--color-title); padding: 35px 20px; border: 2px dashed rgba(60, 40, 20, 0.4); border-radius: 4px; background: rgba(0, 0, 0, 0.03); margin: 10px 0;">
                        <i class="fas fa-user-plus" style="font-size: 2.2em; opacity: 0.55; margin-bottom: 10px; display: block;"></i>
                        <h4 style="margin: 0 0 5px; font-weight: bold; font-family: var(--font-title); font-size: 1.1em;">{{localize "TENEBRE.Party.CharactersEmptyTitle"}}</h4>
                        <p style="margin: 0; font-size: 0.9em; opacity: 0.8;">{{localize "TENEBRE.Party.CharactersEmptyHint"}}</p>
                    </div>
                    {{/unless}}
                </div>
            </div>
        </div>
    </div>
</form>
