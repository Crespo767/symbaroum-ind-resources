<form class="{{cssClass}}" autocomplete="off">
    <div class="player party">
        <div class="sheet-header foreground border">
            <div class="avatar" style="position:relative">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" data-tooltip="{{actor.name}}" />
                {{#ifgt system.nbrOfFailedDeathRoll 0}}
                <div data-tooltip="{{localize "TOOLTIP.DEATH_SKULLS"}}" style="position: absolute; top: 70%;left: 15px;">{{#times system.nbrOfFailedDeathRoll}}<i class="fas fa-skull" style="margin: 5px; color:rgb(255, 255, 255); vertical-align: bottom; -webkit-text-stroke-width: 1px; -webkit-text-stroke-color: rgb(0, 0, 0);"></i>{{/times}}</div>
                {{/ifgt}}
            </div>
            <div class="wrapper-column">
                <div class="wrapper-row">
                    <div class="name">
                        <label for="{{id}}-name">{{localize "BIO.NAME"}}</label>
                        <input id="{{id}}-name" name="name" type="text" value="{{actor.name}}" />
                    </div>
                    {{#ifNotLimited actor}}
                        <div class="experience">
                            <label for="data.experience.total">{{localize "EXPERIENCE"}}</label>
                            <input id="data.experience.total" name="system.experience.total" data-tooltip="{{localize "TENEBRE.Party.ExperienceTotalTooltip"}}" type="number" value="{{system.experience.total}}" data-dtype="Number" />
                            <input name="system.experience.artifactrr" data-tooltip="{{localize "TENEBRE.Party.ExperienceArtifactrrTooltip"}}" type="number" value="{{system.experience.artifactrr}}" data-dtype="Number" />
                        </div>
                    {{/ifNotLimited}}
                </div>
            </div>
        </div>

        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="characters">{{localize "TENEBRE.Party.TabCharacters"}}</b>
            <b class="item" data-tab="inventory">{{localize "TENEBRE.Party.TabInventory"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="characters">
                <div class="party-characters-tab-content">
                    <!-- Seção de Jogadores -->
                    <div class="party-section party-members-section" data-drop-zone="members">
                        <div class="party-section-header">
                            <h3 class="section-title"><i class="fas fa-users"></i> {{localize "TENEBRE.Party.MembersSectionTitle"}} ({{members.length}})</h3>
                        </div>
                        <div class="party-members-list">
                            {{#each members}}
                            <div class="party-member-card foreground" data-actor-id="{{id}}" draggable="true">
                                <!-- Imagem do Personagem -->
                                <div class="member-portrait" data-action="open-member-sheet" data-actor-id="{{id}}" data-tooltip="{{name}}">
                                    <img src="{{img}}" alt="{{name}}" />
                                </div>

                                <!-- Nome e Barras de Vitalidade e Corrupção -->
                                <div class="member-identity" data-action="open-member-sheet" data-actor-id="{{id}}">
                                    <span class="member-name">{{name}}</span>
                                    <div class="member-bars">
                                        <!-- Barra de Vitalidade -->
                                        <div class="member-bar-row toughness-row" data-tooltip="{{localize "HEALTH.TOUGHNESS"}}: {{health.toughness.value}} / {{health.toughness.max}}">
                                            <div class="bar-label">
                                                <i class="fas fa-heart"></i>
                                                <span class="bar-val">{{health.toughness.value}}/{{health.toughness.max}}</span>
                                            </div>
                                            <div class="bar-track">
                                                <div class="bar-fill toughness-fill {{#if health.toughness.isWounded}}is-wounded{{/if}}" style="width: {{health.toughness.pct}}%;"></div>
                                            </div>
                                        </div>
                                        <!-- Barra de Corrupção -->
                                        <div class="member-bar-row corruption-row" data-tooltip="{{localize "HEALTH.CORRUPTION"}}: {{health.corruption.value}} / {{health.corruption.max}}{{#if health.corruption.threshold}} ({{localize "HEALTH.CORRUPTION_THRESHOLD"}}: {{health.corruption.threshold}}){{/if}}">
                                            <div class="bar-label">
                                                <i class="fas fa-burn"></i>
                                                <span class="bar-val">{{health.corruption.value}}/{{health.corruption.max}}</span>
                                            </div>
                                            <div class="bar-track">
                                                <div class="bar-fill corruption-fill {{#if health.corruption.isOverThreshold}}is-over-threshold{{/if}}" style="width: {{health.corruption.pct}}%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Campo de informações: 4 maiores atributos no canto esquerdo -->
                                <div class="member-info-box">
                                    {{#if topAttributes.length}}
                                    <div class="member-top-attributes" data-tooltip="{{#if canRoll}}{{localize "TENEBRE.Party.TopAttributesTooltip"}}{{else}}{{localize "TENEBRE.Party.TopAttributesReadonlyTooltip"}}{{/if}}">
                                        {{#each topAttributes}}
                                        <div class="member-attr-badge {{#if ../canRoll}}is-rollable{{else}}is-readonly{{/if}}" {{#if ../canRoll}}data-action="roll-member-attribute" data-actor-id="{{../id}}" data-attribute="{{key}}"{{/if}} data-tooltip="{{label}}: {{total}}">
                                            <span class="attr-abbr">{{abbr}}</span>
                                            <span class="attr-val">{{total}}</span>
                                        </div>
                                        {{/each}}
                                    </div>
                                    {{/if}}
                                </div>

                                <!-- Informações de Ocupação e XP no campo da direita -->
                                <div class="member-meta" data-action="open-member-sheet" data-actor-id="{{id}}">
                                    {{#if occupation}}
                                    <span class="member-occupation">• {{occupation}}</span>
                                    {{/if}}
                                    {{#if hasXp}}
                                    <span class="member-xp">• XP: {{totalXp}}{{#if availableXp}} ({{availableXp}} livre){{/if}}</span>
                                    {{/if}}
                                </div>

                                <!-- Botões de controle: Alternar para companheiro / Remover -->
                                {{#if ../editable}}
                                <div class="member-actions">
                                    <a class="item-control member-switch" data-action="toggle-member-type" data-actor-id="{{id}}" data-tooltip="{{localize "TENEBRE.Party.MoveToCompanions"}}">
                                        <i class="fas fa-paw"></i>
                                    </a>
                                    <a class="item-control member-delete" data-action="remove-member" data-actor-id="{{id}}" data-tooltip="{{localize "TENEBRE.Party.RemoveMember"}}">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                                {{/if}}
                            </div>
                            {{/each}}

                            {{#unless members.length}}
                            <div class="party-empty-dropzone" data-drop-zone="members">
                                <i class="fas fa-user-plus" style="font-size: 2em; opacity: 0.55; margin-bottom: 8px; display: block;"></i>
                                <h4 style="margin: 0 0 5px; font-weight: bold; font-family: var(--font-title); font-size: 1.05em;">{{localize "TENEBRE.Party.CharactersEmptyTitle"}}</h4>
                                <p style="margin: 0; font-size: 0.85em; opacity: 0.8;">{{localize "TENEBRE.Party.CharactersEmptyHint"}}</p>
                            </div>
                            {{/unless}}
                        </div>
                    </div>

                    <!-- Seção de Companheiros -->
                    <div class="party-section party-companions-section" data-drop-zone="companions">
                        <div class="party-section-header">
                            <h3 class="section-title"><i class="fas fa-paw"></i> {{localize "TENEBRE.Party.CompanionsSectionTitle"}} ({{companions.length}})</h3>
                        </div>
                        <div class="party-companions-list">
                            {{#each companions}}
                            <div class="party-member-card foreground companion-card" data-actor-id="{{id}}" draggable="true">
                                <!-- Imagem do Companheiro -->
                                <div class="member-portrait" data-action="open-member-sheet" data-actor-id="{{id}}" data-tooltip="{{name}}">
                                    <img src="{{img}}" alt="{{name}}" />
                                </div>

                                <!-- Nome e Barras de Vitalidade e Corrupção -->
                                <div class="member-identity" data-action="open-member-sheet" data-actor-id="{{id}}">
                                    <span class="member-name">{{name}}</span>
                                    <div class="member-bars">
                                        <!-- Barra de Vitalidade -->
                                        <div class="member-bar-row toughness-row" data-tooltip="{{localize "HEALTH.TOUGHNESS"}}: {{health.toughness.value}} / {{health.toughness.max}}">
                                            <div class="bar-label">
                                                <i class="fas fa-heart"></i>
                                                <span class="bar-val">{{health.toughness.value}}/{{health.toughness.max}}</span>
                                            </div>
                                            <div class="bar-track">
                                                <div class="bar-fill toughness-fill {{#if health.toughness.isWounded}}is-wounded{{/if}}" style="width: {{health.toughness.pct}}%;"></div>
                                            </div>
                                        </div>
                                        <!-- Barra de Corrupção -->
                                        <div class="member-bar-row corruption-row" data-tooltip="{{localize "HEALTH.CORRUPTION"}}: {{health.corruption.value}} / {{health.corruption.max}}{{#if health.corruption.threshold}} ({{localize "HEALTH.CORRUPTION_THRESHOLD"}}: {{health.corruption.threshold}}){{/if}}">
                                            <div class="bar-label">
                                                <i class="fas fa-burn"></i>
                                                <span class="bar-val">{{health.corruption.value}}/{{health.corruption.max}}</span>
                                            </div>
                                            <div class="bar-track">
                                                <div class="bar-fill corruption-fill {{#if health.corruption.isOverThreshold}}is-over-threshold{{/if}}" style="width: {{health.corruption.pct}}%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Campo de informações: 4 maiores atributos -->
                                <div class="member-info-box">
                                    {{#if topAttributes.length}}
                                    <div class="member-top-attributes" data-tooltip="{{#if canRoll}}{{localize "TENEBRE.Party.TopAttributesTooltip"}}{{else}}{{localize "TENEBRE.Party.TopAttributesReadonlyTooltip"}}{{/if}}">
                                        {{#each topAttributes}}
                                        <div class="member-attr-badge {{#if ../canRoll}}is-rollable{{else}}is-readonly{{/if}}" {{#if ../canRoll}}data-action="roll-member-attribute" data-actor-id="{{../id}}" data-attribute="{{key}}"{{/if}} data-tooltip="{{label}}: {{total}}">
                                            <span class="attr-abbr">{{abbr}}</span>
                                            <span class="attr-val">{{total}}</span>
                                        </div>
                                        {{/each}}
                                    </div>
                                    {{/if}}
                                </div>

                                <!-- Informações de Ocupação e XP no campo da direita -->
                                <div class="member-meta" data-action="open-member-sheet" data-actor-id="{{id}}">
                                    {{#if occupation}}
                                    <span class="member-occupation">• {{occupation}}</span>
                                    {{/if}}
                                    {{#if hasXp}}
                                    <span class="member-xp">• XP: {{totalXp}}{{#if availableXp}} ({{availableXp}} livre){{/if}}</span>
                                    {{/if}}
                                </div>

                                <!-- Botões de controle: Alternar para jogador / Remover -->
                                {{#if ../editable}}
                                <div class="member-actions">
                                    <a class="item-control member-switch" data-action="toggle-member-type" data-actor-id="{{id}}" data-tooltip="{{localize "TENEBRE.Party.MoveToMembers"}}">
                                        <i class="fas fa-user"></i>
                                    </a>
                                    <a class="item-control member-delete" data-action="remove-member" data-actor-id="{{id}}" data-tooltip="{{localize "TENEBRE.Party.RemoveCompanion"}}">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                                {{/if}}
                            </div>
                            {{/each}}

                            {{#unless companions.length}}
                            <div class="party-empty-dropzone companions-empty" data-drop-zone="companions">
                                <i class="fas fa-paw" style="font-size: 2em; opacity: 0.55; margin-bottom: 8px; display: block;"></i>
                                <h4 style="margin: 0 0 5px; font-weight: bold; font-family: var(--font-title); font-size: 1.05em;">{{localize "TENEBRE.Party.CompanionsEmptyTitle"}}</h4>
                                <p style="margin: 0; font-size: 0.85em; opacity: 0.8;">{{localize "TENEBRE.Party.CompanionsEmptyHint"}}</p>
                            </div>
                            {{/unless}}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aba Inventário -->
            <div class="tab" data-group="primary" data-tab="inventory">
                <div class="party-inventory">
                    <!-- Box de Local de Armazenamento / Carga do Grupo -->
                    <div class="party-storage-location-box foreground {{#if storage.hasLocation}}is-linked{{else}}is-unlinked{{/if}}" data-drop-zone="storage-location">
                        {{#if storage.hasLocation}}
                        <div class="storage-linked-container">
                            <!-- Retrato / Ícone do local -->
                            <div class="storage-portrait {{#if storage.canOpenSheet}}is-clickable{{/if}}" {{#if storage.canOpenSheet}}data-action="open-storage-sheet" data-uuid="{{storage.uuid}}" data-id="{{storage.id}}" data-tooltip="{{localize "TENEBRE.Party.OpenStorageSheet"}}"{{/if}}>
                                <img src="{{storage.img}}" alt="{{storage.name}}" />
                            </div>

                            <!-- Informações do Local e Barra de Carga -->
                            <div class="storage-details">
                                <div class="storage-title-row">
                                    <span class="storage-name" {{#if storage.canOpenSheet}}data-action="open-storage-sheet" data-uuid="{{storage.uuid}}" data-id="{{storage.id}}" data-tooltip="{{localize "TENEBRE.Party.OpenStorageSheet"}}"{{/if}}>
                                        {{storage.name}}
                                    </span>
                                    <span class="storage-badge"><i class="{{storage.categoryIcon}}"></i> {{storage.categoryLabel}}</span>
                                    {{#if storage.isOverloaded}}
                                    <span class="storage-badge is-overload-badge"><i class="fas fa-exclamation-triangle"></i> {{localize "TENEBRE.Party.Overloaded"}}</span>
                                    {{/if}}
                                </div>

                                <!-- Barra de Capacidade -->
                                <div class="storage-bar-wrapper" data-tooltip="{{localize "TENEBRE.Party.CurrentLoad"}}: {{storage.currentLoad}} / {{storage.capacity}} {{localize "TENEBRE.Party.Units"}}">
                                    <div class="storage-bar-progress {{#if storage.isOverloaded}}is-overloaded{{/if}}" style="width: {{storage.pct}}%;"></div>
                                </div>

                                <div class="storage-stats-row">
                                    <span class="storage-stats-text">
                                        <i class="fas fa-weight-hanging"></i> {{localize "TENEBRE.Party.CurrentLoad"}}: <strong>{{storage.currentLoad}}</strong> / <strong>{{storage.capacity}}</strong> {{localize "TENEBRE.Party.Units"}} ({{storage.pct}}%)
                                    </span>
                                </div>
                            </div>

                            <!-- Botões de Ação -->
                            {{#if editable}}
                            <div class="storage-actions">
                                {{#if storage.canOpenSheet}}
                                <a class="storage-action-btn" data-action="open-storage-sheet" data-uuid="{{storage.uuid}}" data-id="{{storage.id}}" data-tooltip="{{localize "TENEBRE.Party.OpenStorageSheet"}}">
                                    <i class="fas fa-external-link-alt"></i>
                                </a>
                                {{/if}}
                                <a class="storage-action-btn" data-action="edit-storage-capacity" data-tooltip="{{localize "TENEBRE.Party.EditStorageCapacity"}}">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a class="storage-action-btn" data-action="select-storage-location" data-tooltip="{{localize "TENEBRE.Party.ChangeStorageLocation"}}">
                                    <i class="fas fa-exchange-alt"></i>
                                </a>
                                <a class="storage-action-btn delete-btn" data-action="unlink-storage-location" data-tooltip="{{localize "TENEBRE.Party.UnlinkStorageLocation"}}">
                                    <i class="fas fa-unlink"></i>
                                </a>
                            </div>
                            {{/if}}
                        </div>
                        {{else}}
                        <div class="storage-unlinked-container">
                            <div class="storage-unlinked-icon">
                                <i class="fas fa-dolly"></i>
                            </div>
                            <div class="storage-unlinked-text">
                                <h4 class="storage-unlinked-title">{{localize "TENEBRE.Party.StorageUnlinkedTitle"}}</h4>
                                <p class="storage-unlinked-hint">{{localize "TENEBRE.Party.StorageUnlinkedHint"}}</p>
                            </div>
                            {{#if editable}}
                            <div class="storage-unlinked-actions">
                                <button type="button" class="select-storage-btn" data-action="select-storage-location">
                                    <i class="fas fa-link"></i> {{localize "TENEBRE.Party.LinkStorageBtn"}}
                                </button>
                            </div>
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>

                    {{#if inventoryItems.length}}
                    <div class="party-inventory-content">
                        {{#each inventoryCategories}}
                        <div class="party-inventory-section">
                            <h3 class="section-title"><i class="{{icon}}"></i> {{localize label}} ({{items.length}})</h3>
                            <div class="party-items-list">
                                {{#each items}}
                                <div class="party-item-row foreground item" data-item-id="{{id}}" draggable="true">
                                    <div class="item-icon-box" data-action="open-item-sheet" data-tooltip="{{name}}">
                                        <img src="{{img}}" alt="{{name}}" class="item-img" />
                                    </div>
                                    <div class="item-main-info" data-action="open-item-sheet" data-tooltip="{{name}}">
                                        <span class="item-name">{{name}}</span>
                                        {{#if detail}}<span class="item-detail">({{detail}})</span>{{/if}}
                                    </div>
                                    <div class="item-type-badge">{{typeLabel}}</div>
                                    <div class="item-quantity-box">
                                        {{#if ../../editable}}
                                        <a class="quantity-btn" data-action="decrease-quantity" data-tooltip="{{localize "TENEBRE.Party.DecreaseQuantity"}}">
                                            <i class="fas fa-minus"></i>
                                        </a>
                                        {{/if}}
                                        <span class="quantity-value" data-tooltip="{{localize "EQUIPMENT.QUANTITY_SHORT"}}">{{quantity}}</span>
                                        {{#if ../../editable}}
                                        <a class="quantity-btn" data-action="increase-quantity" data-tooltip="{{localize "TENEBRE.Party.IncreaseQuantity"}}">
                                            <i class="fas fa-plus"></i>
                                        </a>
                                        {{/if}}
                                    </div>
                                    {{#if ../../editable}}
                                    <div class="item-actions">
                                        <a class="item-action-btn delete-btn" data-action="delete-item" data-tooltip="{{localize "TENEBRE.Party.DeleteItem"}}">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                    {{/if}}
                                </div>
                                {{/each}}
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="party-empty-dropzone">
                        <i class="fas fa-boxes" style="font-size: 2.2em; opacity: 0.55; margin-bottom: 10px; display: block;"></i>
                        <h4 style="margin: 0 0 5px; font-weight: bold; font-family: var(--font-title); font-size: 1.1em;">{{localize "TENEBRE.Party.InventoryEmptyTitle"}}</h4>
                        <p style="margin: 0; font-size: 0.9em; opacity: 0.8;">{{localize "TENEBRE.Party.InventoryEmptyHint"}}</p>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</form>
